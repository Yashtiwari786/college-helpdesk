
{% extends "base.html" %}

{% block title %}Reset Staff Password | College Help Desk{% endblock %}

{% block content %}
<style>
    .reset-page { max-width:760px; margin:auto; padding:30px 16px 50px; }
    .reset-heading { margin-bottom:25px; }
    .reset-heading h2 { color:#172033; font-weight:800; margin:0; }
    .reset-heading p { color:#718096; margin:8px 0 0; }
    .reset-card { background:#fff; border:1px solid #e8edf5; border-radius:16px; box-shadow:0 8px 28px rgba(25,40,70,.05); overflow:hidden; }
    .reset-card-header { padding:22px 25px; background:#fffaf0; border-bottom:1px solid #f5e8c8; }
    .reset-card-header h5 { color:#7c4a03; font-weight:750; margin:0 0 6px; }
    .reset-card-header p { color:#866b42; margin:0; font-size:14px; }
    .reset-card-body { padding:26px; }
    .staff-summary { background:#f8faff; border:1px solid #e8edf5; padding:15px; border-radius:12px; margin-bottom:24px; }
    .staff-summary strong { color:#172033; }
    .reset-page .form-label { font-weight:700; color:#344054; font-size:13px; }
    .reset-page .form-control { min-height:46px; border-radius:10px; border-color:#dce3ee; }
    .reset-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:24px; padding-top:22px; border-top:1px solid #edf0f5; }
    @media(max-width:576px) { .reset-card-body { padding:18px; } .reset-actions .btn { width:100%; } }
</style>

<div class="reset-page">
    <div class="reset-heading">
        <h2>Reset Staff Password</h2>
        <p>Set a new password for the selected staff account.</p>
    </div>

    {% if messages %}
        {% for message in messages %}
            <div class="alert alert-{{ message.tags }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endif %}

    <div class="reset-card">
        <div class="reset-card-header">
            <h5>Account Security</h5>
            <p>The new password will replace the existing password immediately after a successful save.</p>
        </div>

        <div class="reset-card-body">
            <div class="staff-summary">
                <div><strong>Staff member:</strong>
                    {{ staff_member.get_full_name|default:staff_member.username }}
                </div>
                <div><strong>Username:</strong> {{ staff_member.username }}</div>
                <div><strong>Email:</strong> {{ staff_member.email }}</div>
            </div>

            <form method="post"
                  action="{% url 'helpdesk:admin_reset_staff_password' staff_member.id %}">
                {% csrf_token %}

                <div class="mb-3">
                    <label for="new_password" class="form-label">New password *</label>
                    <input type="password"
                           id="new_password"
                           name="new_password"
                           class="form-control"
                           autocomplete="new-password"
                           minlength="8"
                           required>
                    <div class="form-text">
                        Choose a strong password. Django should validate it against your configured password rules.
                    </div>
                </div>

                <div class="mb-3">
                    <label for="confirm_password" class="form-label">Confirm new password *</label>
                    <input type="password"
                           id="confirm_password"
                           name="confirm_password"
                           class="form-control"
                           autocomplete="new-password"
                           minlength="8"
                           required>
                </div>

                <div class="alert alert-warning" role="alert">
                    <strong>Important:</strong> The new password will allow the staff member to sign in.
                    Share it securely and encourage them to change it after signing in.
                </div>

                <div class="reset-actions">
                    <button type="submit" class="btn btn-warning">
                        Reset Password
                    </button>
                    <a href="{% url 'helpdesk:admin_staff_detail' staff_member.id %}"
                       class="btn btn-light border">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}